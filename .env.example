LLM_API_KEY=
# Provider: LLM_BASE_URL and LLM_MODEL are required (there are no defaults). Keep one provider uncommented.
# DeepSeek (current app model; see the iteration log, 2026-10-14):
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# NVIDIA (rate-limited for evaluations, about 40 calls per minute):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Course endpoint from the professor (group key, stops working on 2026-10-21 12:00 Lisbon time). Set
# LLM_THINKING=none with it: it rejects the thinking switch. Native tool calls (the Agentic Tutor) work since the
# professor's proxy fix on 2026-10-18.
# LLM_BASE_URL=https://llm-proxy-obfzuamujq-ew.a.run.app/v1
# LLM_MODEL=course-chat
# Reasoning ("thinking") mode of the app model: on, off, or none (send no switch). Off is the default (faster and cheaper).
LLM_THINKING=off
# LLM judge, required by the evaluation command: gpt-oss-20b on NVIDIA, chosen and calibrated in the iteration log
# (2026-10-17 and 2026-10-18). A different model family from LLM_MODEL. Put your NVIDIA key (build.nvidia.com) after
# LLM_JUDGE_API_KEY=. LLM_JUDGE_THINKING: on, off or none, as LLM_THINKING.
LLM_JUDGE_MODEL=openai/gpt-oss-20b
LLM_JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_JUDGE_API_KEY=
LLM_JUDGE_THINKING=none
# Tutor on the screen: routed (default, Router then Course Tutor) or agentic (reads Course Material through read_file).
TUTOR=
