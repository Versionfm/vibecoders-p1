LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Reasoning ("thinking") mode of the app model: on or off. Off is the default (faster and cheaper).
LLM_THINKING=off
# Judge model: a different model family from LLM_MODEL (not DeepSeek). Chosen later by a probe.
LLM_JUDGE_MODEL=
# Tutor on the screen: routed (default, Router then Course Tutor) or agentic (reads Course Material through read_file).
TUTOR=
