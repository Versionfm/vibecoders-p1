LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Reasoning ("thinking") mode of the app model: on or off. Off is the default (much faster on Nemotron).
LLM_THINKING=off
# Judge model: a different model family from LLM_MODEL (not Nemotron). Chosen later by a probe.
LLM_JUDGE_MODEL=
